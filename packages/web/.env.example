# Copy to .env.local for development. In production set these in hPanel.
DATABASE_URL=mysql://root:devroot@127.0.0.1:33061/challengeforge
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# The public URL of the site, no trailing slash.
APP_URL=http://localhost:3100
SITE_SLUG=main
SITE_NAME=ChallengeForge

# AI missions. 'mock' gives canned replies (development, demos); a production
# site refuses to start on mock unless ALLOW_MOCK_LLM_IN_PRODUCTION=true.
LLM_MODE=mock
# With LLM_MODE=live, set the keys for the providers your missions use:
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LLM_BUDGET_USD_PER_USER=2

# Outgoing mail (password reset, email confirmation). In development 'log'
# prints messages to the terminal; a production site needs smtp (or disabled).
MAIL_MODE=log
# MAIL_MODE=smtp
# MAIL_FROM="ChallengeForge <no-reply@your-domain.example>"
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-reply@your-domain.example
# SMTP_PASSWORD=
# REQUIRE_EMAIL_VERIFICATION=false

# Payments (optional). none | mock (development only) | stripe | razorpay
PAYMENTS_PROVIDER=none
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# First-run setup without a command line: the server migrates on start
# (AUTO_MIGRATE, default on) and /setup creates the first admin with this token.
# SETUP_TOKEN=a-long-random-string-of-24-or-more-characters
# AUTO_MIGRATE=true

# Multi-site behind a proxy that rewrites Host: read the domain from X-Forwarded-Host.
# TRUST_FORWARDED_HOST=false

# Pack registry (Admin → Packs). The public one:
# PACK_REGISTRY_URL=https://raw.githubusercontent.com/atultiwari/challengeforge/main/registry/index.json
