# Copy to .env.local for development. In production set these in hPanel.
DATABASE_URL=mysql://root:devroot@127.0.0.1:33061/challengeforge
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# The public URL of the site, no trailing slash.
APP_URL=http://localhost:3100
SITE_SLUG=main
SITE_NAME=ChallengeForge
